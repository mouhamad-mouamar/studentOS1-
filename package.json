{
  "name": "verdent-react-vite-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsc -p tsconfig.server.json && node dist-server/index.js",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json && node -e \"require('fs').writeFileSync('dist-server/package.json', JSON.stringify({type:'commonjs'}))\"",
    "start": "node dist-server/index.js",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "@verdent/auth-js": "0.1.9",
    "@vitejs/plugin-react": "^4.3.4",
    "express": "^5.2.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2"
  }
}
