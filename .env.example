# Supabase (public browser config — Verdent publish injects these automatically)
# For local dev, copy real values from `mcp_verdent_supabase_project_status`.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_VERDENT_OAUTH_INITIATE_URL=

# Server runtime (Verdent publish injects SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY).
# Server-only secret: NEVER commit the real value.
AI_API_KEY=
# OpenAI-compatible provider (defaults shown)
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBED_MODEL=text-embedding-3-small
